{
  "manifest_version": 3,
  "name": "Shopee Flash Sale Ngày Mai",
  "version": "1.1.1",
  "description": "Sao chép Flash Sale của Shop sang tất cả khung giờ còn trống của ngày mai (SL 15, tự xử lý lỗi tồn kho).",
  "permissions": ["storage"],
  "host_permissions": ["https://banhang.shopee.vn/*"],
  "background": { "service_worker": "background.js" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Flash Sale ngày mai",
    "default_icon": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
  },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "content_scripts": [
    {
      "matches": ["https://banhang.shopee.vn/*"],
      "js": ["fs-engine.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
